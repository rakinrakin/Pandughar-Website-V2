{
  "name": "pandughar-industries",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "build:demo": "tsc --noEmit && VITE_DEV_PANEL=true vite build",
    "deploy:demo": "npm run build:demo && npx netlify-cli deploy --prod --dir dist",
    "postinstall": "node scripts/copy-draco.mjs",
    "build:share": "node scripts/make-share.mjs"
  },
  "dependencies": {
    "gsap": "^3.15.1",
    "lenis": "^1.3.27",
    "three": "^0.170.0"
  },
  "devDependencies": {
    "@types/three": "^0.170.0",
    "lil-gui": "^0.21.0",
    "typescript": "^5.7.3",
    "vite": "^8.3.8",
    "vitest": "^5.1.0"
  }
}
